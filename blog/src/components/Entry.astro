---
import {renderComposition,renderMusic} from '../../../shared/renderer.js';
import {postUrl,base} from '../lib/posts.js';
import {orderedEntries,paperColor} from '../../../shared/paper-colors.js';
import {allPosts} from '../lib/posts.js';
const {post}=Astro.props;
const entryIndex=orderedEntries(allPosts()).findIndex(entry=>entry.id===post.id);
const date=new Date(post.publishedAt).toLocaleDateString('en-US',{timeZone:'America/Chicago',month:'long',day:'numeric',year:'numeric'});
---
<article class="reader-entry" style={`--entry-paper:${paperColor(entryIndex)}`}><header>{post.title.trim()?<><h2><a href={postUrl(post)}>{post.title}</a></h2><time datetime={post.publishedAt}>{date}</time></>:<h2><a href={postUrl(post)}><time datetime={post.publishedAt}>{date}</time></a></h2>}</header><Fragment set:html={renderComposition(post,base)+renderMusic(post,base)}/></article>
