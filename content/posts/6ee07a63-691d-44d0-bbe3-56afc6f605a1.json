into a ladder. make it into a noose. make it into anything that might finally get me somewhere. ","marks":[{"type":"textStyle","attrs":{"font":"serif","fontSize":14.666666666666666,"color":"#000000"}}]}]},{"type":"paragraph","attrs":{"lineHeight":1.38,"spaceBefore":0,"spaceAfter":0},"content":[{"type":"text","text":"but the string only knots itself tighter. ","marks":[{"type":"textStyle","attrs":{"font":"serif","fontSize":14.666666666666666,"color":"#000000"}}]}]},{"type":"paragraph","attrs":{"lineHeight":1.38,"spaceBefore":0,"spaceAfter":0},"content":[{"type":"text","text":"it should’ve reached some sort of climax by now. i should’ve blown up my life. it should’ve taken me with it. ","marks":[{"type":"textStyle","attrs":{"font":"serif","fontSize":14.666666666666666,"color":"#000000"}}]}]}]},"font":"handwriting","fontSize":14,"fixedHeight":true}]}],"status":"draft","publishedAt":null,"updatedAt":"2026-10-17T06:43:35.180Z","updatedBy":342274735}