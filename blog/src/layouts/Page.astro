---
import {base as blogBase, siteOrigin} from '../lib/posts.js';
import '../reader.css';
const {title='bbyteeth',description='Personal diary',canonical=blogBase,image,book=false}=Astro.props;
const url=new URL(canonical,siteOrigin);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><link rel="icon" href="data:,"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={url}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={url}/><meta property="og:type" content="website"/>{image&&<meta property="og:image" content={new URL(image,siteOrigin)}/>}<link rel="alternate" type="application/rss+xml" title="bbyteeth" href={`${blogBase}rss.xml`}/>{book&&<script is:inline>if(!new URLSearchParams(location.search).has('reading'))document.documentElement.classList.add('book-js');</script>}</head><body>
<main class="reader public-reader"><slot/></main>
<nav class="fallback-nav" aria-label="Reader"><a href={blogBase}>bbyteeth</a><a href={`${blogBase}archive/`}>Archive</a><a href={`${blogBase}about/`}>About</a><a href={`${blogBase}rss.xml`}>RSS</a></nav>
<script src="../reader.js"></script>
</body></html>
