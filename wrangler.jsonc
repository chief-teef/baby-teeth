{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baby-teeth-studio",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "WRITE_LIMIT",
      "namespace_id": "1416133666",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "PRIVATE_VERIFICATION": "false",
    "GITHUB_CLIENT_ID": "Iv23liU5EJQDmpZLXU8Z"
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "9d9d16c9654e417487b2015a3fd0d7fe"
    }
  ]
}
